# VehicleIQ — Environment Variables
# Copy this to backend/.env and fill in your keys

# OpenAI API Key — enables GPT-powered chatbot
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Zyla API Key — enables live Indian vehicle data lookup
# Get yours at: https://zylalabs.com
ZYLA_API_KEY=
